@echo off
pushd "%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $exe=Join-Path (Get-Location) 'jocky-agent.exe'; if ((Get-FileHash $exe -Algorithm SHA256).Hash -ne '6ff1807f3a0e898c3797ea0b89d8db3291a52ebd3f0c88bfdcd0125a209b4d5c') { throw 'Agent checksum mismatch. Download a fresh package.' }; $dir=Join-Path $env:LOCALAPPDATA 'JockyLab'; New-Item -ItemType Directory -Force $dir | Out-Null; $sid=[Security.Principal.WindowsIdentity]::GetCurrent().User.Value; icacls.exe $dir /inheritance:r /grant:r ('*'+$sid+':(OI)(CI)F') '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' | Out-Null; if ($LASTEXITCODE -ne 0) { throw 'Cannot protect agent credential folder.' }; $env:JOCKY_SERVER_URL='https://jocky-lab.duckdns.org'; $env:JOCKY_AGENT_STATE=Join-Path $dir 'agent-state.json'; $env:JOCKY_SAFE_PATHS=Join-Path $dir 'Collection'; $env:JOCKY_COLLECT_COMMAND_LINES='0'; New-Item -ItemType Directory -Force $env:JOCKY_SAFE_PATHS | Out-Null; if (-not (Test-Path $env:JOCKY_AGENT_STATE)) { $secure=Read-Host 'Paste the one-time enrollment token from JOCKY Endpoints' -AsSecureString; $ptr=[Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure); try { $env:ENROLLMENT_TOKEN=[Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr) } finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr) } }; Write-Host 'Connecting to JOCKY AWS. Keep this window open; Ctrl+C stops this foreground test.'; try { & $exe; if ($LASTEXITCODE -ne 0) { throw 'Agent exited with an error. Read the message above.' } } finally { Remove-Item Env:ENROLLMENT_TOKEN -ErrorAction SilentlyContinue }"
popd
pause
